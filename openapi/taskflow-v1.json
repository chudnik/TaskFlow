{
  "openapi": "3.1.0",
  "info": {
    "title": "TaskFlow API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "security": [],
        "requestBody": {
          "$ref": "#/components/requestBodies/Credentials"
        },
        "responses": {
          "201": {
            "description": "Registered"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "security": [],
        "requestBody": {
          "$ref": "#/components/requestBodies/Credentials"
        },
        "responses": {
          "200": {
            "description": "Access and refresh tokens"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "security": [],
        "responses": {
          "200": {
            "description": "Rotated tokens"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "responses": {
          "204": {
            "description": "Logged out"
          }
        }
      }
    },
    "/projects": {
      "get": {
        "responses": {
          "200": {
            "description": "Visible projects"
          }
        }
      },
      "post": {
        "responses": {
          "201": {
            "description": "Created"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/projects/{projectId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ProjectId"
        }
      ],
      "get": {
        "responses": {
          "200": {
            "description": "Project"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "put": {
        "responses": {
          "200": {
            "description": "Updated"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      },
      "delete": {
        "responses": {
          "200": {
            "description": "Archived"
          }
        }
      }
    },
    "/projects/{projectId}/members": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ProjectId"
        }
      ],
      "get": {
        "responses": {
          "200": {
            "description": "Members"
          }
        }
      },
      "post": {
        "responses": {
          "201": {
            "description": "Member added"
          }
        }
      }
    },
    "/projects/{projectId}/members/{userId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ProjectId"
        },
        {
          "name": "userId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "patch": {
        "responses": {
          "200": {
            "description": "Role changed"
          }
        }
      },
      "delete": {
        "responses": {
          "204": {
            "description": "Member removed"
          }
        }
      }
    },
    "/tasks": {
      "get": {
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectQuery"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/TaskStatus"
            }
          },
          {
            "name": "priority",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/Priority"
            }
          },
          {
            "name": "assignee_id",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "deadline_from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "deadline_to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "overdue",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "title",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "enum": [
                "created_at",
                "updated_at",
                "deadline",
                "priority",
                "title"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Keyset-paginated task list"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      },
      "post": {
        "responses": {
          "201": {
            "description": "Task created"
          }
        }
      }
    },
    "/tasks/{taskId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/TaskId"
        }
      ],
      "get": {
        "responses": {
          "200": {
            "description": "Task"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "put": {
        "responses": {
          "200": {
            "description": "Task updated"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      },
      "delete": {
        "responses": {
          "204": {
            "description": "Task soft-deleted"
          }
        }
      }
    },
    "/tasks/{taskId}/status": {
      "patch": {
        "responses": {
          "200": {
            "description": "Status changed"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/tasks/{taskId}/assignee": {
      "patch": {
        "responses": {
          "200": {
            "description": "Assignee changed"
          }
        }
      }
    },
    "/tasks/{taskId}/comments": {
      "parameters": [
        {
          "$ref": "#/components/parameters/TaskId"
        }
      ],
      "get": {
        "responses": {
          "200": {
            "description": "Comments"
          }
        }
      },
      "post": {
        "responses": {
          "201": {
            "description": "Comment created"
          }
        }
      }
    },
    "/comments/{commentId}": {
      "patch": {
        "responses": {
          "200": {
            "description": "Comment edited"
          }
        }
      },
      "delete": {
        "responses": {
          "204": {
            "description": "Comment deleted"
          }
        }
      }
    },
    "/projects/{projectId}/history": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ProjectId"
        },
        {
          "$ref": "#/components/parameters/Cursor"
        },
        {
          "$ref": "#/components/parameters/PageSize"
        }
      ],
      "get": {
        "responses": {
          "200": {
            "description": "Project audit history"
          }
        }
      }
    },
    "/tasks/{taskId}/history": {
      "parameters": [
        {
          "$ref": "#/components/parameters/TaskId"
        },
        {
          "$ref": "#/components/parameters/Cursor"
        }
      ],
      "get": {
        "responses": {
          "200": {
            "description": "Task audit history"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "ProjectId": {
        "name": "projectId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "TaskId": {
        "name": "taskId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "ProjectQuery": {
        "name": "project_id",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "schema": {
          "type": "string",
          "description": "Opaque signed cursor bound to the normalized query"
        }
      },
      "PageSize": {
        "name": "page_size",
        "in": "query",
        "schema": {
          "type": "integer",
          "default": 25,
          "maximum": 100
        }
      }
    },
    "requestBodies": {
      "Credentials": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "email",
                "password"
              ],
              "properties": {
                "email": {
                  "type": "string",
                  "format": "email"
                },
                "password": {
                  "type": "string",
                  "minLength": 12
                }
              }
            },
            "example": {
              "email": "user@example.com",
              "password": "correct horse battery"
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "$ref": "#/components/responses/ErrorResponse"
      },
      "Unauthorized": {
        "$ref": "#/components/responses/ErrorResponse"
      },
      "NotFound": {
        "$ref": "#/components/responses/ErrorResponse"
      },
      "Conflict": {
        "$ref": "#/components/responses/ErrorResponse"
      },
      "ValidationError": {
        "$ref": "#/components/responses/ErrorResponse"
      },
      "RateLimited": {
        "$ref": "#/components/responses/ErrorResponse"
      },
      "ErrorResponse": {
        "description": "Stable JSON error envelope",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "TaskStatus": {
        "type": "string",
        "enum": [
          "todo",
          "in_progress",
          "done",
          "cancelled"
        ]
      },
      "Priority": {
        "type": "string",
        "enum": [
          "low",
          "medium",
          "high",
          "urgent"
        ]
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "details",
              "request_id"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "request_id": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
